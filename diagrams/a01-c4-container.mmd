
flowchart TB
    User["Business User"]

    subgraph Platform["Enterprise AI Platform — C4 Level 2"]
        direction TB

        UI["Web Interface / API<br/>Open WebUI / FastAPI"]

        Agent["Agent Application<br/>Business Operations Assistant"]

        Orch["Agent Orchestration<br/>LangGraph"]

        Gateway["Model Gateway<br/>LiteLLM"]

        RAG["Knowledge Retrieval Service<br/>RAG / Embeddings"]

        Integration["Enterprise Integration Service<br/>FastAPI / MCP"]

        Policy["Policy Enforcement Service<br/>OPA / Authorization"]

        Obs["Observability Service<br/>OpenTelemetry"]

        State[("Agent State & Knowledge<br/>PostgreSQL / pgvector")]

        UI --> Agent
        Agent --> Orch

        Orch --> Gateway
        Orch --> RAG
        Orch --> Integration

        RAG <--> State
        Orch <--> State

        Orch -->|"Authorize tool action"| Policy
        Integration -->|"Verify permission"| Policy

        UI -.-> Obs
        Agent -.-> Obs
        Orch -.-> Obs
        Gateway -.-> Obs
        Integration -.-> Obs
    end

    LLM["Model Inference<br/>Ollama / Local LLM"]
    ERP["Enterprise Systems<br/>Synthetic ERP / CRM API"]
    Docs["Enterprise Documents<br/>Policies / Reference Data"]
    IAM["Identity Provider<br/>Keycloak"]

    User --> UI

    Gateway <--> LLM
    Integration <--> ERP
    Docs --> RAG
    Policy <--> IAM

